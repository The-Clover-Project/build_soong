package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

bootstrap_go_package {
    name: "soong-sh",
    pkgPath: "android/soong/sh",
    deps: [
        "blueprint",
        "blueprint-gobtools",
        "blueprint-proptools",
        "soong",
        "soong-android",
        "soong-cc",
        "soong-java",
        "soong-tradefed",
    ],
    srcs: [
        "sh_binary.go",
        "sh_enc.go",
    ],
    testSrcs: [
        "sh_binary_test.go",
    ],
    pluginFor: ["soong_build"],
}
